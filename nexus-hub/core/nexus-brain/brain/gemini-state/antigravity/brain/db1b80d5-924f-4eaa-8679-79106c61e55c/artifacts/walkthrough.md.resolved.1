.btn-d{background:var(--surface3);color:var(--accent3);border:1px solid var(--accent3)25}
.note-area{width:100%;min-height:60px;resize:vertical;font-family:'Source Serif 4',serif;font-size:.75rem;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px;color:var(--text);outline:none;line-height:1.5}
.note-area:focus{border-color:var(--accent)40}

/* SECTION */
.section-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.95rem;margin-bottom:12px;display:flex;align-items:center;gap:6px}
