function renderDaily(){
  const ts=getTasks(curDay),c=document.getElementById('dailyTasks');c.innerHTML='';
  const dk=gdk();if(!S.tasks[dk])S.tasks[dk]={};
  let done=0;
  ts.forEach(t=>{const d=S.tasks[dk][t.k]||false;if(d)done++;const div=document.createElement('div');div.className='task-item'+(d?' done':'');div.innerHTML='<button class="task-check '+(d?'checked':'')+'" onclick="togTask(\''+t.k+'\')">'+(d?'✓':'')+'</button><div class="task-body"><div class="task-label">'+t.l+'</div><div class="task-meta">'+t.m+'</div><span class="task-tag '+t.t+'">'+t.t.replace('tag-','').toUpperCase()+'</span></div>';c.appendChild(div);});
  document.getElementById('taskProgress').textContent=Math.round((done/ts.length)*100)+'%';
  document.getElementById('todayDone').textContent=done;document.getElementById('todayTotal').textContent=ts.length;
  updateSummary();
}

async function togTask(k){const dk=gdk();if(!S.tasks[dk])S.tasks[dk]={};S.tasks[dk][k]=!S.tasks[dk][k];SS(S);if(CS.isLoggedIn())await CS.toggleTask(dk,k,S.tasks[dk][k]);renderDaily();updateStreak();}

function renderWorkout(){
  const s=SCHED[curDay],c=document.getElementById('workoutExercises'),sc=document.getElementById('supplementTasks');
  c.innerHTML='';if(s.r){c.innerHTML='<div style="text-align:center;padding:40px;color:var(--text3)">Dinlenme Günü</div>';return;}
  const w=WO[s.w];document.getElementById('workoutTitle').textContent=w.name;
  w.ex.forEach((ex,i)=>{
    const k=curDay+'_'+i,sel=S.alts[k],dn=sel?sel.n:ex.n,dd=sel?sel.t:ex.d,wlH=S.exW[k]||[],lastW=wlH.length?wlH[wlH.length-1].w:'';
    const div=document.createElement('div');div.className='ex-block';
    div.innerHTML='<div class="ex-head"><div class="ex-name"><span class="ex-num">'+(i+1)+'</span>'+dn+'</div><div class="ex-actions"><button class="sm-btn alt" onclick="this.parentElement.parentElement.parentElement.querySelector(\'.alt-panel\').classList.toggle(\'open\')">🔄</button><button class="sm-btn wl" onclick="this.parentElement.parentElement.parentElement.querySelector(\'.wl-panel\').classList.toggle(\'open\')">🏋️'+(lastW?' '+lastW+'kg':'')+'</button></div></div><div class="ex-detail">'+dd+'</div><div class="panel alt-panel"><div class="alt-opt '+(sel?'':'sel')+'" onclick="selAlt('+i+',null)"><span>↩️ '+ex.n+'</span><span class="at">'+ex.d+'</span></div>'+ex.a.map((a,ai)=>'<div class="alt-opt '+(sel&&sel.n===a.n?'sel':'')+'" onclick="selAlt('+i+','+ai+')"><span>'+a.n+'</span><span class="at">'+a.t+'</span></div>').join('')+'</div><div class="panel wl-panel"><div style="display:flex;gap:5px;align-items:center"><input type="number" class="wl-input" id="wl_'+i+'" placeholder="'+(lastW||'kg')+'" step="0.5"><button class="btn btn-p" onclick="logExW('+i+')">Kaydet</button></div></div>';
    c.appendChild(div);
  });
  sc.innerHTML='';SUPPS.forEach((sup,i)=>{const k='s_'+i,d=(S.tasks[gdk()]||{})[k]||false;const div=document.createElement('div');div.className='task-item'+(d?' done':'');div.innerHTML='<button class="task-check '+(d?'checked':'')+'" onclick="togTask(\''+k+'\')">'+(d?'✓':'')+'</button><div class="task-body"><div class="task-label">'+sup.n+'</div><div class="task-meta">'+sup.t+'</div></div>';sc.appendChild(div);});
}

function selAlt(i,ai){const k=curDay+'_'+i;if(ai===null)delete S.alts[k];else S.alts[k]=WO[SCHED[curDay].w].ex[i].a[ai];SS(S);renderWorkout();}
function logExW(i){const v=parseFloat(document.getElementById('wl_'+i).value);if(isNaN(v))return;const k=curDay+'_'+i;if(!S.exW[k])S.exW[k]=[];S.exW[k].push({d:gdk(),w:v});S.totalSets=(S.totalSets||0)+3;S.totalKg=(S.totalKg||0)+(v*3*15);SS(S);renderWorkout();}

function renderMeals(){
  const c=document.getElementById('mealPlan');document.getElementById('mealDayLabel').textContent=DFULL[curDay];c.innerHTML='';
  const s=SCHED[curDay],keys=['bf','pw','lu','sn','di','co'];
  keys.forEach(mk=>{if(mk==='pw'&&s.r)return;const m=MEALS[mk];if(!m)return;const ak=curDay+'_'+mk,sel=S.mealAlts[ak];const div=document.createElement('div');div.className='meal-slot';div.innerHTML='<div class="meal-name">'+(sel||m.name)+'</div>'+(sel?'':'<div class="meal-desc">'+m.desc+'</div>')+'<div class="meal-macros"><span>🔥'+m.m.c+'</span><span>🥩'+m.m.p+'g</span></div><button class="swap-btn" onclick="this.nextElementSibling.classList.toggle(\'open\')">🔄 Alternatif</button><div class="swap-panel openable"><div class="alt-opt '+(sel?'':'sel')+'" onclick="selMeal(\''+mk+'\',null)"><span>↩️ Orijinal</span></div>'+m.alts.map(a=>'<div class="alt-opt '+(sel===a.n?'sel':'')+'" onclick="selMeal(\''+mk+'\',\''+a.n.replace(/'/g,"\\'")+'\')"><span>'+a.n+'</span></div>').join('')+'</div>';c.appendChild(div);});
}
function selMeal(mk,an){const k=curDay+'_'+mk;if(an===null)delete S.mealAlts[k];else S.mealAlts[k]=an;SS(S);renderMeals();}

function renderShopping(){['protein','veg','grain','other'].forEach(key=>{const c=document.getElementById('shop'+key.charAt(0).toUpperCase()+key.slice(1));if(!c)return;c.innerHTML='';if(!S.shopC[key])S.shopC[key]={};SHOP[key].forEach((item,i)=>{const k=key+'_'+i,d=S.shopC[key][k]||false;const div=document.createElement('div');div.className='shop-item'+(d?' done':'');div.innerHTML='<button class="shop-check '+(d?'checked':'')+'" onclick="togShop(\''+key+'\',\''+k+'\')">'+(d?'✓':'')+'</button><span style="flex:1">'+item.i+'</span><span style="font-family:DM Mono,monospace;font-size:.55rem;color:var(--text3)">'+item.q+'</span>';c.appendChild(div);});});}
function togShop(k,idx){if(!S.shopC[k])S.shopC[k]={};S.shopC[k][idx]=!S.shopC[k][idx];SS(S);renderShopping();}

function renderProgress(){
  const dots=document.getElementById('streakDots');dots.innerHTML='';for(let i=0;i<7;i++){const d=document.createElement('div');d.className='streak-dot'+(i<S.streak?' filled':'')+(i===S.streak?' today-dot':'');dots.appendChild(d);}
  document.getElementById('bigStreak').textContent=S.streak;
  renderWeightChart();
}

function renderWeightChart(){const c=document.getElementById('weightChart'),entries=Object.entries(S.weights).sort();if(!entries.length){c.innerHTML='<div style="text-align:center;padding:12px;color:var(--text3);font-size:.75rem">Kilo girilmemiş</div>';return;}const vals=entries.map(e=>e[1]),mn=Math.min(...vals)-1,mx=Math.max(...vals)+1,rng=mx-mn||1;let h='<div class="mini-chart">';entries.slice(-14).forEach(([d,w])=>{h+='<div class="mc-bar" data-val="'+w+'kg" style="height:'+(((w-mn)/rng)*100)+'%;background:var(--accent)"></div>';});h+='</div>';document.getElementById('headerWeight').textContent=entries[entries.length-1][1];c.innerHTML=h;}

function renderAchievements(){
  const c=document.getElementById('achList');c.innerHTML='';let earned=0;
  ACHIEVEMENTS.forEach(ach=>{
    const unlocked=ach.check();if(unlocked)earned++;
    const div=document.createElement('div');div.className='achievement '+(unlocked?'unlocked':'locked');
    div.innerHTML='<div class="ach-icon">'+ach.icon+'</div><div class="ach-body"><div class="ach-name">'+ach.name+'</div><div class="ach-desc">'+ach.desc+'</div></div><div class="ach-badge '+(unlocked?'earned':'locked-bg')+'">'+(unlocked?'✓':'🔒')+'</div>';
    c.appendChild(div);
  });
  document.getElementById('achCount').textContent=earned+'/'+ACHIEVEMENTS.length;
}

function renderBody(){
  const c=document.getElementById('measureHistory'),entries=Object.entries(S.measurements).sort().reverse();
  if(!entries.length)c.innerHTML='<div style="text-align:center;padding:16px;color:var(--text3);font-size:.75rem">Ölçü yok</div>';
  else{let h='';entries.slice(0,5).forEach(([dt,m])=>{h+='<div style="padding:8px;background:var(--surface2);border-radius:6px;margin-bottom:6px"><div style="font-family:DM Mono,monospace;font-size:.6rem;color:var(--accent)">'+dt+'</div><div style="font-size:.65rem">';Object.entries(m).forEach(([k,v])=>h+=k+':'+v+' ');h+='</div></div>';});c.innerHTML=h;}
}

function saveMeasurements(){
  const m={};['Chest','Waist','Hip','Arm','Thigh','Neck'].forEach(id=>{const v=parseFloat(document.getElementById('m'+id).value);if(!isNaN(v))m[id.toLowerCase()]=v;document.getElementById('m'+id).value='';});
  if(!Object.keys(m).length)return;S.measurements[gdk()]=m;SS(S);renderBody();showNotif('📏 Kaydedildi','');
}

function renderWeekly(){
  const c=document.getElementById('weekGrid');if(!c)return;c.innerHTML='';
  DAYS.forEach((d,i)=>{
    const s=SCHED[i],div=document.createElement('div');div.className='week-day'+(i===curDay?' today':'')+(s.r?' rest':'');
    div.innerHTML='<div class="wd-name">'+d+'</div><div class="wd-type">'+(s.r?'Dinlenme':s.l)+'</div>';
    c.appendChild(div);
  });
}

function renderCheckpoints(){
  const c=document.getElementById('checkpointList');if(!c)return;c.innerHTML='';
  [ {w:'Hafta 1',t:'Başlangıç',s:'nx'}, {w:'Hafta 4',t:'Döngü Sonu',s:'up'} ].forEach(cp=>{
    const div=document.createElement('div');div.className='checkpoint cp-'+cp.s;
    div.innerHTML='<div class="cp-title">'+cp.w+' — '+cp.t+'</div>';
    c.appendChild(div);
  });
}

function updateSummary(){
  const dk=gdk(),w=S.water[dk]||0;document.getElementById('waterVal').textContent=w+'/10';document.getElementById('waterBar').style.width=(w*10)+'%';
  const sl=S.sleep[dk]||0;document.getElementById('sleepVal').textContent=sl?sl+'h':'--';document.getElementById('sleepBar').style.width=Math.min(100,(sl/9)*100)+'%';
}

function renderWaterCups(){const c=document.getElementById('waterCups');c.innerHTML='';const dk=gdk(),w=S.water[dk]||0;for(let i=0;i<10;i++){const cup=document.createElement('div');cup.className='water-cup'+(i<w?' filled':'');cup.onclick=()=>{S.water[dk]=S.water[dk]===(i+1)?i:i+1;SS(S);if(CS.isLoggedIn())CS.saveWater(dk,S.water[dk]);renderWaterCups();updateSummary();};c.appendChild(cup);}}

function logSleep(){const v=parseFloat(document.getElementById('sleepInput').value);if(isNaN(v))return;S.sleep[gdk()]=v;SS(S);updateSummary();}
function setSQ(q){S.sleepQ[gdk()]=q;document.querySelectorAll('.sleep-star').forEach((s,i)=>s.classList.toggle('lit',i<q));}
function logWeight(){const v=parseFloat(document.getElementById('weightInput').value);if(isNaN(v))return;S.weights[gdk()]=v;SS(S);renderWeightChart();document.getElementById('headerWeight').textContent=v;}
function renderWeightHistory(){const c=document.getElementById('weightHistory');const e=Object.entries(S.weights).sort().reverse().slice(0,5);c.innerHTML=e.map(([d,w])=>d+': '+w+'kg').join(' | ');}

function loadNotes(){const dk=gdk();document.getElementById('dailyNote').value=S.notes[dk]||'';}
function saveNote(){const dk=gdk(),v=document.getElementById('dailyNote').value;S.notes[dk]=v;SS(S);if(CS.isLoggedIn())CS.saveNote(dk,v);showNotif('📝 Kaydedildi','');}

function setSW(){const v=parseFloat(document.getElementById('startWeight').value);if(!isNaN(v)){S.startWeight=v;SS(S);}}
function setTW(){const v=parseFloat(document.getElementById('targetWeight').value);if(!isNaN(v)){S.targetWeight=v;SS(S);}}
function exportData(){const blob=new Blob([JSON.stringify(S)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='dean_fit_backup.json';a.click();}
function resetAll(){if(confirm('Tüm veriler silinsin mi?')){localStorage.removeItem(SK);location.reload();}}
