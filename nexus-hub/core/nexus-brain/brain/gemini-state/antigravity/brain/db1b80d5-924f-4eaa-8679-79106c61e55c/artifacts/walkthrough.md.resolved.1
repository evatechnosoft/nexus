.wd-name{font-family:'DM Mono',monospace;font-size:.55rem;color:var(--text3);margin-bottom:2px}
.wd-type{font-family:'Syne',sans-serif;font-size:.65rem;font-weight:600;margin-bottom:4px}
.wd-tasks{font-family:'DM Mono',monospace;font-size:.5rem;color:var(--text3)}
