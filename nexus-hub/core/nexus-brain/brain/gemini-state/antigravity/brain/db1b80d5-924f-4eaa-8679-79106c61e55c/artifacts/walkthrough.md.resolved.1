let liveState={active:false};
function startLive(){const s=SCHED[curDay];if(s.r){showNotif('Dinlenme','Bugün antrenman yok');return;}const w=WO[s.w];liveState={active:true,exIdx:0,setIdx:0,wo:w};document.getElementById('liveOverlay').classList.add('show');document.getElementById('liveTitle').textContent=w.name;renderLive();}
function closeLive(){if(liveState.active&&liveState.exIdx>0){S.woLog[gdk()]=(S.woLog[gdk()]||'')+liveState.exIdx+' egzersiz | ';SS(S);showNotif('Kaydedildi',liveState.exIdx+' egzersiz');}liveState.active=false;document.getElementById('liveOverlay').classList.remove('show');renderWorkout();}
function renderLive(){
  if(!liveState.active)return;const w=liveState.wo;
  if(liveState.exIdx>=w.ex.length){
    document.getElementById('liveBody').innerHTML='<div style="text-align:center;padding:40px 0"><div style="font-size:3rem;margin-bottom:12px">🎉</div><div style="font-family:Syne,sans-serif;font-weight:800;font-size:1.5rem">TAMAMLANDI!</div><div style="font-size:.85rem;color:var(--text2);margin-top:6px">'+w.ex.length+' egzersiz</div></div>';
    document.getElementById('liveFooter').innerHTML='<button class="btn btn-p" onclick="closeLive()">✓ Kapat</button>';
    document.getElementById('liveProgress').textContent='100%';document.getElementById('liveProgressBar').style.width='100%';return;
  }
  const ex=w.ex[liveState.exIdx],selKey=curDay+'_'+liveState.exIdx,dn=S.alts[selKey]?S.alts[selKey].n:ex.n;
  const lastW=(S.exW[selKey]||[]),lastVal=lastW.length?lastW[lastW.length-1].w:'';
  const pct=Math.round((liveState.exIdx/w.ex.length)*100);
  document.getElementById('liveProgress').textContent=pct+'%';document.getElementById('liveProgressBar').style.width=pct+'%';
  let setsH='';for(let i=0;i<ex.sets;i++){const cls=i<liveState.setIdx?'done':(i===liveState.setIdx?'current':'');setsH+='<div class="live-set '+cls+'" onclick="completeSet('+i+')"><div class="ls-num">'+(i+1)+'</div><div class="ls-label">'+(cls==='done'?'✓':(cls==='current'?'▶':''))+'</div></div>';}
  document.getElementById('liveBody').innerHTML='<div style="font-family:DM Mono,monospace;font-size:.65rem;color:var(--accent);text-align:center;margin-bottom:6px">EGZERSİZ '+(liveState.exIdx+1)+'/'+w.ex.length+'</div><div class="live-ex-name">'+dn+'</div><div class="live-ex-detail">'+ex.d+' — '+ex.reps+' tekrar</div><div class="live-set-grid">'+setsH+'</div><div style="display:flex;gap:6px;justify-content:center;align-items:center;margin:12px 0"><input type="number" class="live-input" id="liveWeight" placeholder="'+(lastVal||'kg')+'" step="0.5"><span style="font-family:DM Mono,monospace;font-size:.7rem;color:var(--text2)">kg</span></div>';
  const isLast=liveState.setIdx>=ex.sets;
  document.getElementById('liveFooter').innerHTML=(liveState.exIdx>0?'<button class="btn btn-s" onclick="prevEx()">←</button>':'')+(!isLast?'<button class="btn btn-p" onclick="completeSet('+liveState.setIdx+')">✓ Set Tamamla</button>':'<button class="btn btn-p" onclick="nextEx()">Sonraki →</button>')+'<button class="btn btn-s" onclick="openTimer(90)">⏱️</button>';
}
function completeSet(si){const ex=liveState.wo.ex[liveState.exIdx],w=parseFloat(document.getElementById('liveWeight')?.value)||0,k=curDay+'_'+liveState.exIdx;if(w>0){if(!S.exW[k])S.exW[k]=[];S.exW[k].push({d:gdk(),w:w});S.totalSets=(S.totalSets||0)+1;S.totalKg=(S.totalKg||0)+w;SS(S);}liveState.setIdx++;if(liveState.setIdx>=ex.sets)openTimer(90);renderLive();}
function nextEx(){liveState.exIdx++;liveState.setIdx=0;openTimer(90);renderLive();}
function prevEx(){if(liveState.exIdx>0){liveState.exIdx--;liveState.setIdx=0;renderLive();}}

