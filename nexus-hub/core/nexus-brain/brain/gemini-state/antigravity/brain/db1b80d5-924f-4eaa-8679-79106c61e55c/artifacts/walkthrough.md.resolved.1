.task-check{width:18px;height:18px;border-radius:4px;border:2px solid var(--border);background:none;cursor:pointer;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;transition:all .2s;color:transparent;font-size:.6rem}
.task-check:hover{border-color:var(--accent)40}.task-check.checked{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.task-body{flex:1}.task-label{font-size:.8rem;margin-bottom:1px}.task-meta{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--text3)}
.task-tag{font-family:'DM Mono',monospace;font-size:.5rem;padding:1px 6px;border-radius:5px;display:inline-block;margin-top:2px}
.tag-exercise{background:var(--accent2)10;color:var(--accent2)}.tag-meal{background:var(--accent)10;color:var(--accent)}.tag-recovery{background:var(--accent4)10;color:var(--accent4)}.tag-supplement{background:var(--accent5)10;color:var(--accent5)}

/* EXERCISE */
.ex-block{margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}.ex-block:last-child{border-bottom:none}
.ex-head{display:flex;align-items:center;justify-content:space-between;gap:6px;flex-wrap:wrap}
.ex-name{font-family:'Syne',sans-serif;font-weight:600;font-size:.85rem;display:flex;align-items:center;gap:6px}
.ex-num{color:var(--accent);font-family:'DM Mono',monospace;font-size:.6rem}
.ex-detail{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--text3);margin:3px 0 6px 22px}
.ex-actions{display:flex;gap:4px;flex-wrap:wrap}
.sm-btn{font-family:'DM Mono',monospace;font-size:.55rem;background:var(--surface3);border:1px solid var(--border);padding:4px 8px;border-radius:5px;cursor:pointer;transition:all .2s;text-decoration:none;display:inline-block}
.sm-btn.alt{color:var(--accent2)}.sm-btn.alt:hover{border-color:var(--accent2);background:var(--accent2)10}
.sm-btn.wl{color:var(--accent4)}.sm-btn.wl:hover{border-color:var(--accent4);background:var(--accent4)10}
.sm-btn.vid{color:var(--accent5)}.sm-btn.vid:hover{border-color:var(--accent5);background:var(--accent5)10}
.panel{display:none;margin-top:6px;padding:8px;background:var(--surface2);border-radius:var(--radius-sm);border:1px solid var(--border)}
.panel.open{display:block;animation:tabIn .2s}
.alt-opt{padding:6px 8px;border-radius:5px;cursor:pointer;font-size:.75rem;transition:background .15s;display:flex;justify-content:space-between;align-items:center}
.alt-opt:hover{background:var(--surface3)}
