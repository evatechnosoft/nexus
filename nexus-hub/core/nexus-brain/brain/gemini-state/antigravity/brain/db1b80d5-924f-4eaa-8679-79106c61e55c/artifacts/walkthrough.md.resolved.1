      <div class="card" style="margin-bottom:12px">
        <div class="card-header"><div class="card-title">📊 Özet</div></div>
        <div class="progress-row"><div class="progress-label"><span>🥩 Protein</span><span id="proteinVal">0/130g</span></div><div class="progress-bar"><div class="progress-fill fill-green" id="proteinBar" style="width:0%"></div></div></div>
        <div class="progress-row"><div class="progress-label"><span>🔥 Kalori</span><span id="calVal">0/1750</span></div><div class="progress-bar"><div class="progress-fill fill-blue" id="calBar" style="width:0%"></div></div></div>
        <div class="progress-row"><div class="progress-label"><span>💧 Su</span><span id="waterVal">0/10</span></div><div class="progress-bar"><div class="progress-fill fill-blue" id="waterBar" style="width:0%"></div></div></div>
        <div class="progress-row"><div class="progress-label"><span>😴 Uyku</span><span id="sleepVal">--</span></div><div class="progress-bar"><div class="progress-fill fill-purple" id="sleepBar" style="width:0%"></div></div></div>
      </div>
