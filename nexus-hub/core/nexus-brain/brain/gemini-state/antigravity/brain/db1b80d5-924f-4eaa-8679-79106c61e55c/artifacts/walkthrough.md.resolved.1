.shop-item:last-child{border-bottom:none}
.shop-check{width:16px;height:16px;border-radius:3px;border:2px solid var(--border);background:none;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .15s;color:transparent;font-size:.55rem}
.shop-check:hover{border-color:var(--accent)40}.shop-check.checked{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.shop-item.done{opacity:.3;text-decoration:line-through}

/* WEEK GRID */
.week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
