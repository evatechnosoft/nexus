function getTasks(d){
  const ts=[],s=SCHED[d],id=0;
  ts.push({l:'Kahvaltı',m:'07:30',t:'tag-meal',k:'bf'});
  if(!s.r){ts.push({l:'Antrenman',m:s.l,t:'tag-exercise',k:'wo'});ts.push({l:'Protein shake',m:'10:00',t:'tag-meal',k:'pw'});}
  ts.push({l:'Öğle',m:'12:30',t:'tag-meal',k:'lu'});
  ts.push({l:'Ara',m:'16:00',t:'tag-meal',k:'sn'});
  ts.push({l:'Akşam',m:'19:30',t:'tag-meal',k:'di'});
  ts.push({l:'10 bardak su',m:'Gün boyu',t:'tag-recovery',k:'water'});
