function renderDaily(){
  const ts=getTasks(curDay),c=document.getElementById('dailyTasks');c.innerHTML='';
  const dk=gdk();if(!S.tasks[dk])S.tasks[dk]={};
  let done=0;
  ts.forEach(t=>{const d=S.tasks[dk][t.k]||false;if(d)done++;const div=document.createElement('div');div.className='task-item'+(d?' done':'');div.innerHTML='<button class="task-check '+(d?'checked':'')+'" onclick="togTask(\''+t.k+'\')">'+(d?'✓':'')+'</button><div class="task-body"><div class="task-label">'+t.l+'</div><div class="task-meta">'+t.m+'</div><span class="task-tag '+t.t+'">'+t.t.replace('tag-','').toUpperCase()+'</span></div>';c.appendChild(div);});
  document.getElementById('taskProgress').textContent=Math.round((done/ts.length)*100)+'%';
  document.getElementById('todayDone').textContent=done;document.getElementById('todayTotal').textContent=ts.length;
  const qi=Math.floor(Math.random()*QUOTES.length);document.getElementById('dailyQuote').textContent=QUOTES[qi].t;document.getElementById('quoteAuthor').textContent='— '+QUOTES[qi].a;
  SS(S);
}

async function togTask(k){const dk=gdk();if(!S.tasks[dk])S.tasks[dk]={};S.tasks[dk][k]=!S.tasks[dk][k];SS(S);if(CS.isLoggedIn())await CS.toggleTask(dk,k,S.tasks[dk][k]);renderDaily();updateStreak();}

