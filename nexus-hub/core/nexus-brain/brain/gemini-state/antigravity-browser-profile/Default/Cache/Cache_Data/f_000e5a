<!-- Add Modal -->
<div class="modal fade shadow-lg" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 bg-dark text-white shadow-2xl">
      <form id="addInventForm" method="post" action="/inventory/add">
        <div class="modal-header border-bottom border-secondary border-opacity-25 p-4">
          <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-3 text-primary"></i>Yeni Cihaz Ekle</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 p-md-5">
          <div class="row g-4">
            <div class="col-md-6">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">Cihaz Türü</label>
              <select name="device_type" class="form-select bg-dark border-secondary border-opacity-50 text-white p-2" required>
                
                <option value="Laptop">Laptop</option>
                
                <option value="Telefon">Telefon</option>
                
                <option value="Tablet">Tablet</option>
                
                <option value="Masaüstü">Masaüstü</option>
                
                <option value="Aksesuar">Aksesuar</option>
                
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">Marka</label>
              <input type="text" name="brand" class="form-control bg-dark border-secondary border-opacity-50 text-white p-2" placeholder="Örn: Apple, Dell" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">Model</label>
              <input type="text" name="model" class="form-control bg-dark border-secondary border-opacity-50 text-white p-2" placeholder="Örn: MacBook Air M2" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">Seri Numarası *</label>
              <input type="text" name="serial_no" class="form-control bg-dark border-secondary border-opacity-50 text-white p-2" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">IMEI (Opsiyonel)</label>
              <input type="text" name="imei" class="form-control bg-dark border-secondary border-opacity-50 text-white p-2">
            </div>
            <div class="col-12">
              <label class="form-label small text-muted text-uppercase fw-bold ls-1 mb-2">Notlar</label>
              <textarea name="notes" class="form-control bg-dark border-secondary border-opacity-50 text-white p-2" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25 p-4">
          <button type="button" class="btn btn-link text-white text-decoration-none" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary px-5 shadow-lg">Cihazı Kaydet</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Durum Modal -->
<div class="modal fade shadow-lg" id="statusModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <form method="post" id="statusForm" class="modal-content border-0 bg-dark text-white">
      <div class="modal-header border-bottom border-secondary border-opacity-25">
        <h5 class="modal-title fw-bold">Durum Güncelle</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <select name="status" id="statusSelect" class="form-select bg-dark border-secondary text-white">
          
          <option value="Depoda">Depoda</option>
          
          <option value="Dağıtıldı">Dağıtıldı</option>
          
          <option value="Serviste">Serviste</option>
          
          <option value="Hurda">Hurda</option>
          
        </select>
      </div>
      <div class="modal-footer border-top border-secondary border-opacity-25">
        <button type="button" class="btn btn-link text-white text-decoration-none" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="btn btn-primary px-4">Kaydet</button>
      </div>
    </form>
  </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
function openStatusModal(id, currentStatus) {
  const form = document.getElementById('statusForm');
  const select = document.getElementById('statusSelect');
  form.action = '/inventory/update-status/' + id;
  select.value = currentStatus;
  const modal = new bootstrap.Modal(document.getElementById('statusModal'));
  modal.show();
}
</script>

</body>
</html>