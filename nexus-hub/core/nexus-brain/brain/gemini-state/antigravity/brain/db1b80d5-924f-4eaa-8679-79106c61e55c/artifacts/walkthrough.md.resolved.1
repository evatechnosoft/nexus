@keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.timer-display{font-family:'Syne',sans-serif;font-weight:800;font-size:2.5rem;color:var(--accent4);line-height:1}
.timer-label{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--text2);margin:4px 0 10px}
.timer-btns{display:flex;gap:6px;justify-content:center}
.timer-btn{font-family:'DM Mono',monospace;font-size:.6rem;padding:5px 10px;border-radius:5px;border:1px solid var(--border);background:var(--surface2);color:var(--text);cursor:pointer;transition:all .2s}
.timer-btn:hover{border-color:var(--accent4)40}.timer-btn.primary{background:var(--accent4);color:var(--bg);border-color:var(--accent4)}

/* NOTIFICATION */
.notification{position:fixed;top:60px;right:16px;z-index:500;background:var(--surface);border:1px solid var(--accent);border-radius:var(--radius);padding:12px 16px;box-shadow:0 12px 40px rgba(0,0,0,.4);font-size:.8rem;max-width:300px;transform:translateX(120%);transition:transform .4s}
.notification.show{transform:translateX(0)}
.notif-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.8rem;margin-bottom:2px}.notif-body{font-size:.75rem;color:var(--text2)}

/* PHOTOS */
.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}
.photo-card{position:relative;border-radius:8px;overflow:hidden;border:1px solid var(--border);cursor:pointer;aspect-ratio:1}
.photo-card img{width:100%;height:100%;object-fit:cover;display:block}
.photo-overlay{position:absolute;bottom:0;left:0;right:0;padding:4px 6px;background:linear-gradient(transparent,rgba(0,0,0,.7));font-family:'DM Mono',monospace;font-size:.5rem;color:#fff}
.photo-del{position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;border:none;background:rgba(0,0,0,.5);color:#fff;cursor:pointer;font-size:.6rem}

/* LIVE */
.live-overlay{display:none;position:fixed;inset:0;z-index:300;background:var(--bg);flex-direction:column}
.live-overlay.show{display:flex;animation:tabIn .3s}
.live-header{padding:16px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);background:var(--surface)}
.live-body{flex:1;overflow-y:auto;padding:20px;max-width:800px;margin:0 auto;width:100%}
.live-footer{padding:16px 20px;border-top:1px solid var(--border);background:var(--surface);display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.live-ex-name{font-family:'Syne',sans-serif;font-weight:800;font-size:1.5rem;margin-bottom:4px;text-align:center}
.live-ex-detail{font-family:'DM Mono',monospace;font-size:.8rem;color:var(--text2);margin-bottom:20px;text-align:center}
.live-set-grid{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:16px 0}
.live-set{width:60px;height:60px;border-radius:12px;border:2px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;font-family:'DM Mono',monospace}
.live-set .ls-num{font-size:1rem;font-weight:700}.live-set .ls-label{font-size:.5rem;color:var(--text3)}
.live-set.done{background:var(--accent)15;border-color:var(--accent);color:var(--accent)}
.live-set.current{border-color:var(--accent4);box-shadow:0 0 12px var(--accent4)30}
.live-input{width:80px;font-family:'DM Mono',monospace;font-size:1.2rem;text-align:center;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);outline:none;font-weight:700}
.live-input:focus{border-color:var(--accent)50}
.live-progress{height:4px;background:var(--surface3);border-radius:2px;margin:0}.live-progress-fill{height:100%;border-radius:2px;background:var(--accent);transition:width .3s}

/* REPORT */
.report-card{background:linear-gradient(135deg,var(--accent)06,var(--accent2)06);border:1px solid var(--accent)15;border-radius:var(--radius);padding:20px}
.report-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
@media(max-width:768px){.report-grid{grid-template-columns:repeat(2,1fr)}}
.report-stat{background:var(--surface);border-radius:var(--radius-sm);padding:12px;text-align:center;border:1px solid var(--border)}
.report-val{font-family:'Syne',sans-serif;font-weight:800;font-size:1.5rem;line-height:1}
.report-label{font-family:'DM Mono',monospace;font-size:.55rem;color:var(--text3);margin-top:2px}
</style>
</head>
<body>

<!-- NOTIFICATION -->
<div class="notification" id="notification"><div class="notif-title" id="notifTitle"></div><div class="notif-body" id="notifBody"></div></div>

<!-- LOGIN OVERLAY -->
<div class="login-overlay" id="loginOverlay">
