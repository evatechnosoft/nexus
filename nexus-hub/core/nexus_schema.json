{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus Skill Index Schema",
  "description": "Schema for skill-index.json and individual skill definitions.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "2.0"
    },
    "total": {
      "type": "integer"
    },
    "last_update": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillEntry"
      }
    }
  },
  "required": ["version", "skills"],
  "definitions": {
    "SkillEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for the skill (kebab-case recommended)."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what the skill does."
        },
        "category": {
          "type": "string",
          "default": "general"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keywords or phrases that should trigger this skill."
        },
        "source": {
          "type": "string",
          "enum": ["local", "ddgs", "brave", "serper", "manual"],
          "default": "local"
        },
        "path": {
          "type": "string",
          "description": "Local path to the skill definition or script."
        },
        "url": {
          "type": "string",
          "description": "Remote URL where the skill was fetched from."
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "vector": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Embedding vector for semantic search (e.g. 384 dimensions)."
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Raw text chunks and their individual vectors."
        },
        "embedding_model": {
          "type": "string",
          "description": "The model used to generate the vectors."
        },
        "embedding_cached": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["name"]
    }
  }
}
