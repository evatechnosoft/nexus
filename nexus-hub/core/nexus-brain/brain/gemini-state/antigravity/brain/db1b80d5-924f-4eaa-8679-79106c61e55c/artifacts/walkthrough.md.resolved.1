let tSec=90,tRun=false,tInt=null;
function openTimer(s){tSec=s;tRun=false;clearInterval(tInt);updTimer();document.getElementById('timerOverlay').classList.add('show');document.getElementById('timerToggle').textContent='▶';}
function closeTimer(){clearInterval(tInt);tRun=false;document.getElementById('timerOverlay').classList.remove('show');}
function togTimer(){if(tRun){clearInterval(tInt);tRun=false;document.getElementById('timerToggle').textContent='▶';}else{tRun=true;document.getElementById('timerToggle').textContent='⏸';tInt=setInterval(()=>{tSec--;if(tSec<=0){clearInterval(tInt);tRun=false;document.getElementById('timerToggle').textContent='▶';tSec=0;try{const c=new(window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=880;g.gain.value=.3;o.start();setTimeout(()=>{o.stop();c.close();},300);}catch(e){}}updTimer();},1000);}}
function adjTimer(d){tSec=Math.max(0,tSec+d);updTimer();}
function updTimer(){const m=Math.floor(tSec/60),s=tSec%60;document.getElementById('timerDisplay').textContent=m+':'+(s<10?'0':'')+s;}

