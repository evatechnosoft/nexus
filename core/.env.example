# Nexus Hub Environment Configuration Example
# Copy this file to .env in the root and fill in the values.
# DO NOT COMMIT YOUR .env FILE TO SOURCE CONTROL.

# --- Core Settings ---
# Directory for storing data (skills, memory, vault). Defaults to /app or user home.
NEXUS_DATA_DIR=./data
# Secret token for Nexus Vault access. If empty, an ephemeral token is generated.
NEXUS_VAULT_TOKEN=

# --- API Keys (for Skills & Search) ---
# OpenAI API Key (for embeddings/LLM tasks)
OPENAI_API_KEY=
# Groq API Key (for fast inference)
GROQ_API_KEY=
# Brave Search API Key (for nexus_fetch)
BRAVE_API_KEY=
# Serper.dev API Key (alternative search)
SERPER_API_KEY=

# --- MCP Server Settings ---
# The URL where Nexus MCP server is reachable (if hosted)
NEXUS_HUB_URL=http://localhost:8900

# --- AgentOps-Nexus Integration (Optional) ---
# Port for the AgentOps-Nexus sub-service
AGENTOPS_PORT=4500
# Database for AgentOps (PostgreSQL)
AGENTOPS_DATABASE_URL=postgresql://nexus_user:password@localhost:5432/agentops_nexus
# Microsoft Graph / Azure Integration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
EXCHANGE_EMAIL=

# --- Messenger Bridge ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
