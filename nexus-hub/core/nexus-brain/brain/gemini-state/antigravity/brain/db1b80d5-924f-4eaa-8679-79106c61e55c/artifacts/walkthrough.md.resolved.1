.streak-dot.filled{background:var(--accent);border-color:var(--accent)}.streak-dot.today-dot{border-color:var(--accent4);background:var(--accent4)}

/* ACHIEVEMENTS */
.achievement{display:flex;align-items:center;gap:10px;padding:10px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:6px;border:1px solid var(--border);transition:all .3s}
.achievement.unlocked{border-color:var(--accent4)40}.achievement.locked{opacity:.4}
.ach-icon{font-size:1.3rem;flex-shrink:0}.ach-body{flex:1}
