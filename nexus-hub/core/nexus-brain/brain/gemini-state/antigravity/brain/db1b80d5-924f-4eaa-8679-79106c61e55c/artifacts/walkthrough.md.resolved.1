  <div class="timer-label">SET ARASI</div>
  <div class="timer-btns">
    <button class="timer-btn" onclick="adjTimer(-15)">-15</button>
    <button class="timer-btn primary" onclick="togTimer()" id="timerToggle">▶</button>
    <button class="timer-btn" onclick="adjTimer(15)">+15</button>
    <button class="timer-btn" onclick="closeTimer()">✕</button>
  </div>
</div>

<!-- LIVE OVERLAY -->
