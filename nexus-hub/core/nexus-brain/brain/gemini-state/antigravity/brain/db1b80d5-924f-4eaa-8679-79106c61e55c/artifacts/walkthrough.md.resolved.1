    <div style="display:flex;gap:6px;align-items:center">
      <div class="badge green" id="liveProgress">0%</div>
      <button class="icon-btn" onclick="closeLive()">✕</button>
    </div>
  </div>
  <div class="live-progress"><div class="live-progress-fill" id="liveProgressBar" style="width:0%"></div></div>
  <div class="live-body" id="liveBody"></div>
  <div class="live-footer" id="liveFooter"></div>
</div>

<!-- HEADER -->
<header class="header">
  <div class="header-inner">
    <div class="logo">DEAN<span>.fit</span></div>
    <div class="header-center">
      <div class="badge green" id="cycleBadge">HAFTA 1</div>
