function renderProgress(){
  const dots=document.getElementById('streakDots');dots.innerHTML='';for(let i=0;i<7;i++){const d=document.createElement('div');d.className='streak-dot'+(i<S.streak?' filled':'')+(i===S.streak?' today-dot':'');dots.appendChild(d);}
  document.getElementById('bigStreak').textContent=S.streak;
  const wk=getWeeks(),p1=Math.min(100,wk>=2?100:(wk/2)*100),p2=Math.min(100,wk<=2?0:wk>=4?100:((wk-2)/2)*100),p3=Math.min(100,wk<=4?0:((wk-4)/4)*100);
  document.getElementById('ph1').textContent=Math.round(p1)+'%';document.getElementById('ph1b').style.width=p1+'%';
  document.getElementById('ph2').textContent=Math.round(p2)+'%';document.getElementById('ph2b').style.width=p2+'%';
  document.getElementById('ph3').textContent=Math.round(p3)+'%';document.getElementById('ph3b').style.width=p3+'%';
  renderWeightChart();renderSleepChart();renderProgressiveChart();renderReport();
}
function renderWeightChart(){const c=document.getElementById('weightChart'),entries=Object.entries(S.weights).sort();if(!entries.length){c.innerHTML='<div style="text-align:center;padding:12px;color:var(--text3);font-size:.75rem">Kilo girilmemiş</div>';return;}const vals=entries.map(e=>e[1]),mn=Math.min(...vals)-1,mx=Math.max(...vals)+1,rng=mx-mn;let h='<div class="mini-chart">';entries.slice(-14).forEach(([d,w])=>{h+='<div class="mc-bar" data-val="'+w+'kg '+d.slice(5)+'" style="height:'+(((w-mn)/rng)*100)+'%;background:linear-gradient(to top,var(--accent),var(--accent2))"></div>';});h+='</div><div class="mc-labels">';entries.slice(-14).forEach(([d])=>{h+='<div class="mc-label">'+d.slice(5)+'</div>';});h+='</div>';document.getElementById('headerWeight').textContent=entries[entries.length-1][1];c.innerHTML=h;}
function renderSleepChart(){const c=document.getElementById('sleepChart'),entries=Object.entries(S.sleep).sort().slice(-14);if(!entries.length){c.innerHTML='<div style="text-align:center;padding:12px;color:var(--text3);font-size:.75rem">Uyku girilmemiş</div>';return;}let h='<div class="mini-chart">';entries.forEach(([d,hrs])=>{const q=S.sleepQ[d]||3,col=q>=4?'var(--accent)':q>=3?'var(--accent4)':'var(--accent3)';h+='<div class="mc-bar" data-val="'+hrs+'h Q:'+q+'" style="height:'+Math.min(100,(hrs/10)*100)+'%;background:'+col+'"></div>';});h+='</div><div class="mc-labels">';entries.forEach(([d])=>{h+='<div class="mc-label">'+d.slice(5)+'</div>';});h+='</div>';c.innerHTML=h;}
function renderProgressiveChart(){const c=document.getElementById('progressiveChart'),entries=S.exW['0_0']||[];if(!entries.length){c.innerHTML='<div style="text-align:center;padding:12px;color:var(--text3);font-size:.75rem">Ağırlık kaydı yok</div>';return;}const vals=entries.map(e=>parseFloat(e.w)),mn=Math.min(...vals)-5,mx=Math.max(...vals)+5,rng=mx-mn||1;let h='<div class="mini-chart">';entries.slice(-10).forEach(e=>{h+='<div class="mc-bar" data-val="'+e.w+'kg" style="height:'+(((parseFloat(e.w)-mn)/rng)*100)+'%;background:linear-gradient(to top,var(--accent4),#ff9800)"></div>';});h+='</div><div class="mc-labels">';entries.slice(-10).forEach(e=>{h+='<div class="mc-label">'+e.d.slice(5)+'</div>';});h+='</div>';const trend=vals.length>=2?(vals[vals.length-1]-vals[0]>0?'📈 Artış':'➡️ Stabil'):'';c.innerHTML=h+(trend?'<div style="text-align:center;font-family:DM Mono,monospace;font-size:.6rem;color:var(--accent4);margin-top:6px">'+trend+'</div>':'');}

async function renderReport(){
  if(CS.isLoggedIn()){
    try{const r=await CS.getWeeklyReport();if(!r.error){
      document.getElementById('rW').textContent=r.workouts+'/4';document.getElementById('rP').textContent=(r.avgSleep||'--')+'h';document.getElementById('rS').textContent=(r.avgWater||'--');document.getElementById('rK').textContent=r.weightChange?(r.weightChange>0?'+':'')+r.weightChange+'kg':'--';
      document.getElementById('reportInsight').textContent=r.insights?.join(' ')||'Veriler toplanıyor...';
      return;
    }}catch(e){}
  }
  // Local fallback
  let wc=0;for(let i=0;i<7;i++){const d=new Date();d.setDate(d.getDate()-i);if(S.woLog[d.toISOString().split('T')[0]])wc++;}
  document.getElementById('rW').textContent=wc+'/4';
  const slE=Object.values(S.sleep),avgS=slE.length?(slE.reduce((a,b)=>a+b,0)/slE.length).toFixed(1):'--';
  document.getElementById('rP').textContent=avgS+'h';
  document.getElementById('reportInsight').textContent=wc>=4?'Antrenman hedefi tuttu!':'Antrenman sayısı düşük.';
}

