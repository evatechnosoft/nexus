 document.getElementById('work-actions"><button class="sm-btn alt" onclick="this.parentElement.parentElement.querySelector(\'.alt-panel\').classList.toggle(\'open\')">🔄</button><button class="sm-btn wl" onclick="this.parentElement.parentElement.querySelector(\'.wl-panel\').classList.toggle(\'open\')">🏋️'+(lastW?' '+lastW+'kg':'')+'</button><a class="sm-btn vid" href="https://www.google.com/search?q='+encodeURIComponent(dn+' exercise form')+'&tbm=vid" target="_blank" style="text-decoration:none">📹</a></div></div><div class="ex-detail">'+dd+'</div><div class="panel alt-panel"><div class="alt-opt '+(sel?'':'sel')+'" onclick="selAlt('+i+',null)"><span>↩️ '+ex.n+'</span><span class="at">'+ex.d+'</span></div>'+ex.a.map((a,ai)=>'<div class="alt-opt '+(sel&&sel.n===a.n?'sel':'')+'" onclick="selAlt('+i+','+ai+')"><span>'+a.n+'</span><span class="at">'+a.t+'</span></div>').join('')+'</div><div class="panel wl-panel"><div style="display:flex;gap:5px;align-items:center"><input type="number" class="wl-input" id="wl_'+i+'" placeholder="'+(lastW||'kg')+'" step="0.5"><span style="font-family:DM Mono,monospace;font-size:.55rem;color:var(--text3)">kg</span><button class="btn btn-p" onclick="logExW('+i+')">Kaydet</button></div><div style="font-family:DM Mono,monospace;font-size:.55rem;color:var(--text3);margin-top:4px">'+(wlH.slice(-5).map(h=>h.d.slice(5)+':'+h.w+'kg').join(' → ')||'Kayıt yok')+'</div></div>';
