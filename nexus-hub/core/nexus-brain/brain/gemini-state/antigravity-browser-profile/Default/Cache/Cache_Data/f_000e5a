<!-- Arama & Filtre -->
<form method="get" action="/inventory/" class="card border-0 shadow-sm mb-4 p-4 bg-glass">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <label class="form-label small text-muted mb-1">Cihaz Ara (Seri No, Marka, Model)</label>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" name="q" class="form-control bg-dark border-secondary text-white" placeholder="Örn: C123456..." value="" />
      </div>
    </div>
    <div class="col-md-3">
      <label class="form-label small text-muted mb-1">Durum</label>
      <select name="status" class="form-select bg-dark border-secondary text-white">
        <option value="">Tümü</option>
        
        <option value="Depoda" >Depoda</option>
        
        <option value="Dağıtıldı" >Dağıtıldı</option>
        
        <option value="Serviste" >Serviste</option>
        
        <option value="Hurda" >Hurda</option>
        
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label small text-muted mb-1">Tür</label>
      <select name="type" class="form-select bg-dark border-secondary text-white">
        <option value="">Tümü</option>
        
        <option value="Laptop" >Laptop</option>
        
        <option value="Telefon" >Telefon</option>
        
        <option value="Tablet" >Tablet</option>
        
        <option value="Masaüstü" >Masaüstü</option>
        
        <option value="Aksesuar" >Aksesuar</option>
        
      </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-primary flex-fill">Filtrele</button>
      <a href="/inventory/" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
    </div>
  </div>
</form>

