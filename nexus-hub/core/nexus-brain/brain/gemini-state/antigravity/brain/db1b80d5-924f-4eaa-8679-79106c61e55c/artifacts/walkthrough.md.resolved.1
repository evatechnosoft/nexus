  try{const r=await CS.uploadPhoto(file,type,'');document.getElementById('uploadBar').style.width='100%';setTimeout(()=>{document.getElementById('uploadProgress').style.display='none';},1000);if(r.photo){showNotif('📸 Yüklendi',type);loadPhotos();}else showNotif('❌ Hata',r.error||'Yükleme başarısız');}catch(e){showNotif('❌ Hata',e.message);document.getElementById('uploadProgress').style.display='none';}
