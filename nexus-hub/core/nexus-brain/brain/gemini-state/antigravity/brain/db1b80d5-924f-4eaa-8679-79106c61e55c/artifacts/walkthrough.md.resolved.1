/* TIMER */
.timer-overlay{display:none;position:fixed;bottom:16px;right:16px;z-index:200;background:var(--surface);border:2px solid var(--accent4);border-radius:var(--radius);padding:16px 22px;box-shadow:0 16px 48px rgba(0,0,0,.5);text-align:center;min-width:180px}
