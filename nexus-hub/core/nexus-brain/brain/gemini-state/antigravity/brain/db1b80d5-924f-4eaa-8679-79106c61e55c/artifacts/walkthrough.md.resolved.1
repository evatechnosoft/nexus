.alt-opt.sel{background:var(--accent)10;color:var(--accent)}.alt-opt.sel .at{color:var(--accent)}
.wl-input{width:60px;font-family:'DM Mono',monospace;font-size:.7rem;background:var(--surface3);border:1px solid var(--border);border-radius:5px;padding:5px 6px;color:var(--text);outline:none}
.wl-input:focus{border-color:var(--accent)40}

/* PROGRESS BARS */
.progress-row{margin-bottom:10px}
.progress-label{display:flex;justify-content:space-between;font-family:'DM Mono',monospace;font-size:.65rem;margin-bottom:4px}
.progress-bar{height:6px;background:var(--surface3);border-radius:3px;overflow:hidden}
.progress-fill{height:100%;border-radius:3px;transition:width .5s}
.fill-green{background:linear-gradient(90deg,var(--accent),#00ffb3)}
.fill-blue{background:linear-gradient(90deg,var(--accent2),#0088ff)}
.fill-yellow{background:linear-gradient(90deg,var(--accent4),#ff9800)}
.fill-red{background:linear-gradient(90deg,var(--accent3),#ff4444)}
