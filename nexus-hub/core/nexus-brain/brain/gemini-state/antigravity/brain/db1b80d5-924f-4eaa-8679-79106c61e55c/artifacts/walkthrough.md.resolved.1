async function loadPhotos(){
  if(!CS.isLoggedIn()){document.getElementById('photoGrid').innerHTML='<div style="grid-column:1/-1;text-align:center;color:var(--text3);padding:16px;font-size:.75rem">Cloud girişi gerekli</div>';return;}
