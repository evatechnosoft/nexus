      <img class="avatar" id="userAvatar" style="display:none" onclick="handleLogout()" title="Çıkış">
      <button class="icon-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
    </div>
  </div>
</header>

<!-- NAV -->
<nav class="nav">
  <div class="nav-inner">
    <button class="nav-btn active" data-tab="daily">📋GÜNLÜK</button>
    <button class="nav-btn" data-tab="workout">💪SPOR</button>
    <button class="nav-btn" data-tab="meals">🥗BESLENME</button>
    <button class="nav-btn" data-tab="shop">🛒ALIŞVERİŞ</button>
    <button class="nav-btn" data-tab="progress">📊İLERLEME</button>
    <button class="nav-btn" data-tab="achievements">🏆BAŞARIMLAR</button>
    <button class="nav-btn" data-tab="body">📏ÖLÇÜLER</button>
