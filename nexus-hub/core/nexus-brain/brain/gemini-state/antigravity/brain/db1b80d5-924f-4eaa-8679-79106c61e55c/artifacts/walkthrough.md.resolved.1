.timer-btn:hover{border-color:var(--accent4)40}.timer-btn.primary{background:var(--accent4);color:var(--bg);border-color:var(--accent4)}

/* NOTIFICATION */
.notification{position:fixed;top:60px;right:16px;z-index:500;background:var(--surface);border:1px solid var(--accent);border-radius:var(--radius);padding:12px 16px;box-shadow:0 12px 40px rgba(0,0,0,.4);font-size:.8rem;max-width:300px;transform:translateX(120%);transition:transform .4s}
