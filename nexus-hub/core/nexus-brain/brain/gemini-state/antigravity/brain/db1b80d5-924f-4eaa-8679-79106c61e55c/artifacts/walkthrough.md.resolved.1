.checkpoint{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:10px;position:relative;overflow:hidden}
.checkpoint::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;border-radius:3px 0 0 3px}
.cp-up::before{background:var(--text3)}.cp-nx::before{background:var(--accent4)}.cp-dn::before{background:var(--success)}
.cp-date{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--text3)}.cp-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.9rem;margin:3px 0}.cp-desc{font-size:.75rem;color:var(--text2)}
