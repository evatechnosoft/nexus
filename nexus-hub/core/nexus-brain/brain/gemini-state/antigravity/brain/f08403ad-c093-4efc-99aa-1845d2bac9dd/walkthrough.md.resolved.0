                      child: SvgPicture.string(
                        '''<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="100" cy="100" r="100" fill="#6200EE"/>
  <circle cx="100" cy="100" r="85" fill="#7C3FFF"/>
  <path d="M 50 60 Q 45 60 45 65 L 45 140 Q 45 145 50 145 L 80 145 Q 85 145 85 140 L 85 65 Q 85 60 80 60 Z" fill="white" opacity="0.95"/>
  <line x1="55" y1="75" x2="75" y2="75" stroke="#E0E0E0" stroke-width="2" stroke-linecap="round"/>
  <line x1="55" y1="85" x2="75" y2="85" stroke="#E0E0E0" stroke-width="2" stroke-linecap="round"/>
  <line x1="55" y1="95" x2="75" y2="95" stroke="#E0E0E0" stroke-width="2" stroke-linecap="round"/>
