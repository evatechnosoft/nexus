        <div style="font-family:'DM Mono',monospace;font-size:.55rem;color:var(--text3);margin:4px 0 2px">Kalite:</div>
        <div class="sleep-stars" id="sleepStars"><span class="sleep-star" onclick="setSQ(1)">★</span><span class="sleep-star" onclick="setSQ(2)">★</span><span class="sleep-star" onclick="setSQ(3)">★</span><span class="sleep-star" onclick="setSQ(4)">★</span><span class="sleep-star" onclick="setSQ(5)">★</span></div>
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title">⚖️ Kilo</div></div>
        <div class="input-row"><input type="number" class="input-field" id="weightInput" placeholder="94.5" step="0.1"><button class="btn btn-p" onclick="logWeight()">Kaydet</button></div>
