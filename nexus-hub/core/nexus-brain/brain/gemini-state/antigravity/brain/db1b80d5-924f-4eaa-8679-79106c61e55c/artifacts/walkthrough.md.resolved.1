  async api(endpoint, opts = {}) {
    const headers = { 'Content-Type': 'application/json' };
    if (this.token) headers['Authorization'] = 'Bearer ' + this.token;
    try {
      const res = await fetch(API + endpoint, { ...opts, headers: { ...headers, ...(opts.headers || {}) } });
      if (res.status === 401) { this.logout(); return { error: 'Oturum doldu' }; }
      return res.json();
    } catch (e) { return { error: e.message }; }
  },

  // Auth
  async googleAuth(credential) { const r = await this.api('/auth/google', { method: 'POST', body: JSON.stringify({ credential }) }); if (r.token) this.setAuth(r); return r; },
  async login(email, password) { const r = await this.api('/auth/login', { method: 'POST', body: JSON.stringify({ email, password }) }); if (r.token) this.setAuth(r); return r; },
  async register(username, email, password) { const r = await this.api('/auth/register', { method: 'POST', body: JSON.stringify({ username, email, password }) }); if (r.token) this.setAuth(r); return r; },

  // Sync
  async pullFromCloud() { return this.api('/sync/pull'); },
  async pushToCloud(data) { return this.api('/sync/push', { method: 'POST', body: JSON.stringify(data) }); },
  async saveWeight(date, weight) { return this.api('/sync/weight', { method: 'POST', body: JSON.stringify({ date, weight }) }); },
  async saveSleep(date, hours, quality) { return this.api('/sync/sleep', { method: 'POST', body: JSON.stringify({ date, hours, quality }) }); },
  async saveWater(date, cups) { return this.api('/sync/water', { method: 'POST', body: JSON.stringify({ date, cups }) }); },
  async toggleTask(date, task_key, completed) { return this.api('/sync/task', { method: 'POST', body: JSON.stringify({ date, task_key, completed }) }); },
  async saveNote(date, content) { return this.api('/sync/note', { method: 'POST', body: JSON.stringify({ date, content }) }); },
  async saveAchievement(id) { return this.api('/sync/achievement', { method: 'POST', body: JSON.stringify({ achievement_id: id }) }); },

  // Photos
  async uploadPhoto(file, type, notes) {
    const fd = new FormData(); fd.append('photo', file); fd.append('photo_type', type); fd.append('notes', notes);
    const res = await fetch(API + '/photos/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + this.token }, body: fd });
    return res.json();
  },
  async getPhotos(type, limit) { let ep = '/photos'; const p = []; if (type) p.push('type=' + type); if (limit) p.push('limit=' + limit); if (p.length) ep += '?' + p.join('&'); return this.api(ep); },
  async deletePhoto(id) { return this.api('/photos/' + id, { method: 'DELETE' }); },

  // Analytics
  async getWeeklyReport() { return this.api('/analytics/weekly'); },
  async getProgression(idx) { return this.api('/analytics/progression/' + idx); },

  // Auto sync
  startAutoSync(ms = 5 * 60 * 1000) {
    this.stopAutoSync();
    this._si = setInterval(() => { if (this.isLoggedIn()) this.pushToCloud(S); }, ms);
  },
  stopAutoSync() { if (this._si) { clearInterval(this._si); this._si = null; } },
};

