function renderAchievements(){
  const c=document.getElementById('achList');c.innerHTML='';let earned=0;
  ACHIEVEMENTS.forEach(ach=>{
    const unlocked=ach.check();if(unlocked)earned++;
    if(unlocked&&!S.achievements[ach.id]){S.achievements[ach.id]=gdk();SS(S);if(CS.isLoggedIn())CS.saveAchievement(ach.id);setTimeout(()=>showNotif('🏆 Başarım!',ach.name+' — '+ach.desc),500);}
    const div=document.createElement('div');div.className='achievement '+(unlocked?'unlocked':'locked');
    div.innerHTML='<div class="ach-icon">'+ach.icon+'</div><div class="ach-body"><div class="ach-name">'+ach.name+'</div><div class="ach-desc">'+ach.desc+'</div></div><div class="ach-badge '+(unlocked?'earned':'locked-bg')+'">'+(unlocked?'✓':'🔒')+'</div>';
    c.appendChild(div);
  });
  document.getElementById('achCount').textContent=earned+'/'+ACHIEVEMENTS.length;
  document.getElementById('statW').textContent=countWO();document.getElementById('statS').textContent=S.totalSets||0;
  document.getElementById('statKg').textContent=(S.totalKg||0).toLocaleString();document.getElementById('statStreak').textContent=S.bestStreak||0;
  document.getElementById('statDays').textContent=Object.keys(S.tasks).length;
  const next=ACHIEVEMENTS.find(a=>!a.check());
  document.getElementById('nextGoals').innerHTML=next?'<div style="padding:12px;background:var(--surface2);border-radius:8px;border:1px solid var(--accent4)20"><div style="font-size:1.2rem;margin-bottom:4px">'+next.icon+'</div><div style="font-family:Syne,sans-serif;font-weight:600;font-size:.85rem">'+next.name+'</div><div style="font-size:.75rem;color:var(--text2)">'+next.desc+'</div></div>':'<div style="text-align:center;padding:16px;color:var(--accent)">🎉 Tümü kazanıldı!</div>';
}
function countWO(){return Object.keys(S.exW).reduce((a,k)=>a+(S.exW[k]?.length?1:0),0);}
function countPD(){let c=0;Object.keys(S.tasks).forEach(dk=>{if(S.tasks[dk]?.bf&&S.tasks[dk]?.lu&&S.tasks[dk]?.di)c++;});return c;}
function countWD(){let c=0;Object.entries(S.water).forEach(([dk,v])=>{if(v>=10)c++;});return c;}

